# Copy this file to .env and fill in your details

# Your email address (the sender / "you")
SENDER_EMAIL=your_email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SENDER_APP_PASSWORD=your_app_password_here

# Your name (appears in emails sent to you)
SENDER_NAME=Your Name

# Flask secret key (change this to something random)
SECRET_KEY=change-me-to-a-random-secret-key

# Optional: custom message signature
SIGNATURE=Warm wishes
