# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Email (required) ──────────────────────────────────────────────────────────
SENDER_EMAIL=your@gmail.com
SENDER_APP_PASSWORD=your-app-password
SENDER_NAME=Birthday Bot
SIGNATURE=Warm wishes
EMAIL_PROVIDER=gmail          # gmail | outlook | yahoo | custom
# SMTP_HOST_CUSTOM=smtp.example.com
# SMTP_PORT_CUSTOM=587

# ── OpenAI (AI messages, gift suggestions, voice TTS, theme suggestions) ──────
OPENAI_API_KEY=sk-...

# ── Twilio (SMS & WhatsApp) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Webhooks ──────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: python -c "from notifications import generate_vapid_keys; import json; print(json.dumps(generate_vapid_keys(), indent=2))"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=your@gmail.com

# ── Auth ──────────────────────────────────────────────────────────────────────
LOGIN_REQUIRED=false           # set to true to require password
APP_PASSWORD=                  # auto-creates admin on first run
